# Copy this file to .env.local and fill in values.
# Never commit .env.local or real secrets.
# Restart `next dev` after changing environment variables.

# -----------------------------------------------------------------------------
# Public site config (safe to expose in the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=dot.com

# -----------------------------------------------------------------------------
# Firebase web SDK (public identifiers, still do not hardcode in source)
# Used only from Client Components or shared config. Not secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-only). Never prefix with NEXT_PUBLIC_.
# Set these in Vercel project settings for production.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
